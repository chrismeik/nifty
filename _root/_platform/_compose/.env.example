# Host user — run `id -u` and `id -g` to get these values
UID=1000
GID=1000

# Database settings
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appdb

# Connection URLs (auto-derived from above — change only if using external services)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2

# Logging & Metrics
LOG_LEVEL=DEBUG
ENABLE_WORKER_METRICS=true
WORKER_METRICS_PORT=8001

# GitHub
GITHUB_TOKEN=

# Neo4j / Graphiti
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=           # set a strong password

# AI providers
ANTHROPIC_API_KEY=        # https://console.anthropic.com
OPENAI_API_KEY=           # https://platform.openai.com/api-keys

# AWS (only required if using S3 parquet storage)
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 copy (_root/_ops/_dataops/_s3_copy) — one bucket per project + lane
S3_COPY_ENABLED=false
S3_COPY_BUCKET=               # e.g. veratree-bot-sandbox
S3_COPY_PREFIX=               # optional leading prefix; leave empty to mirror the tree

# Product-specific vars live in each product's _platform/_compose/.env