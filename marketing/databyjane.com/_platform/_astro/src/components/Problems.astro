---
// <product id="978ffe15-85f7-416e-ad91-aeb0d2223c90">
import { problems } from '../data/problems';
---
<section class="problems" aria-labelledby="problems-title">
  <div class="container">
    <p class="eyebrow">Sound familiar?</p>
    <h2 id="problems-title">Common data problems</h2>
    <p class="lead">These are the problems districts most often ask me about.</p>
    <ul class="grid">
      {problems.map((p, i) => (
        <li class="card" id={`problem-${p.id}`}>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.title}</h3>
          <p>{p.problem}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    list-style: none; margin-top: 2rem;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;
  }
  .card {
    background: white; border: 1px solid var(--sand-200); border-radius: var(--radius);
    padding: 1.5rem;
  }
  .num { font-size: 0.85rem; font-weight: 700; color: var(--accent-dark); }
  h3 { font-size: 1.1rem; color: var(--brand-900); margin: 0.35rem 0 0.5rem; }
  p { color: var(--ink-700); font-size: 0.97rem; }
</style>
