---
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProductPageStyles from '../components/ProductPageStyles.astro';
import SmsCarousel from '../components/SmsCarousel.astro';

---
<Layout
  title="Enter the Nifty Attendance&#8482; Raffle — 2026 MSBA Conference"
  description="Fill out the form below for a chance to win at the 2026 MSBA Annual Conference. You'll also receive example SMS messages parents get from Nifty Attendance™."
>
<product id="a1f7e3b2-dc84-4f19-b6c1-8e0d5a2c9f47">
  <style is:global>
    @import "../styles/_tokens.css";

    .demo-layout { padding: 2.5rem 2rem 5rem; }
    .demo-inner {
      max-width: 960px; margin: 0 auto;
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 3rem; align-items: start;
    }
    .demo-inner > product { display: block; min-width: 0; }
    @media (max-width: 700px) {
      .demo-inner { grid-template-columns: 1fr; gap: 2rem; }
    }

    /* <product id="6e2aece0-ade7-403a-a2f1-e125a1985ae5"> */
    .demo-form-card {
      background: white; border: 1px solid var(--slate-200);
      border-radius: 16px; padding: 2rem;
      display: flex; flex-direction: column; gap: 1.25rem; min-width: 0;
    }
    .demo-field { display: flex; flex-direction: column; gap: 0.4rem; }
    .demo-field label {
      font-size: 0.8rem; font-weight: 700; color: var(--slate-700);
      letter-spacing: 0.02em;
    }
    .demo-field input, .demo-field select {
      padding: 0.7rem 1rem; border: 1.5px solid var(--slate-200);
      border-radius: 8px; font-size: 0.95rem; color: var(--slate-800);
      transition: border-color 0.15s; width: 100%;
      background: white; appearance: none;
    }
    .demo-field input:focus, .demo-field select:focus { outline: none; border-color: var(--accent); }
    .demo-field input::placeholder { color: var(--slate-300); }
    .demo-submit {
      background: var(--accent); color: white;
      border: none; border-radius: 8px; padding: 0.9rem 1.5rem;
      font-size: 1rem; font-weight: 700; cursor: pointer;
      transition: background 0.15s, transform 0.1s;
      box-shadow: 0 4px 14px rgba(249,115,22,0.3);
    }
    .demo-submit:hover { background: var(--accent-hover); transform: translateY(-2px); }
    .demo-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .demo-privacy { font-size: 0.75rem; color: var(--slate-400); text-align: center; line-height: 1.5; }
    .demo-success {
      display: none; flex-direction: column; align-items: center;
      gap: 1rem; text-align: center; padding: 2rem 1rem;
    }
    .demo-success-icon {
      width: 3rem; height: 3rem; border-radius: 50%;
      background: #ecfdf5; border: 2px solid #10b981;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem;
    }
    .demo-success-title { font-size: 1.15rem; font-weight: 800; color: var(--slate-900); }
    .demo-success-sub { font-size: 0.9rem; color: var(--slate-500); line-height: 1.6; }
    /* </product> */
  </style>

  <ProductPageStyles />
  <Nav />

  <!-- PAGE HERO -->
  <product id="d9e2c841-5b73-4a68-f7c0-3e1a8b6d0f52">
  <section class="page-hero">
    <h1>Enter the<br/><span>Nifty Attendance&#8482; Raffle!!</span></h1>
    <p>Enter for a chance to win — and get a firsthand look at how Nifty Attendance&#8482; is helping schools recover ADA funding and reduce chronic absenteeism.</p>
  </section>
  </product>

  <div class="demo-layout">
    <div class="demo-inner">

      <!-- LEAD FORM -->
      <product id="b8c53f17-9d46-4e72-a2b0-7f8e1c5d9a63">
      <div class="demo-form-card">
        <div id="demo-form-body">
          <form id="demo-form" onsubmit="handleSubmit(event)">
            <div style="display:flex;flex-direction:column;gap:1.25rem;">
              <input type="text" name="website" id="demo-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
              <div class="demo-field">
                <label for="demo-name">Your name</label>
                <input type="text" id="demo-name" name="name" placeholder="Jane Smith" required />
              </div>
              <div class="demo-field">
                <label for="demo-phone">Phone number</label>
                <input type="tel" id="demo-phone" name="phone" placeholder="(555) 000-0000" required />
              </div>
              <div class="demo-field">
                <label for="demo-district">District name</label>
                <input type="text" id="demo-district" name="district" placeholder="Springfield R-XII School District" required />
              </div>
              <div class="demo-field">
                <label for="demo-email">School email</label>
                <input type="email" id="demo-email" name="email" placeholder="jane@springfield.k12.mo.us" />
              </div>
              <div class="demo-field">
                <label for="demo-sis">Current student information system (SIS)</label>
                <select id="demo-sis" name="sis">
                  <option value="" disabled selected>Select your SIS…</option>
                  <option>PowerSchool</option>
                  <option>Infinite Campus</option>
                  <option>Skyward</option>
                  <option>Tyler SIS</option>
                  <option>Frontline (eSchoolPlus)</option>
                  <option>Synergy (Edupoint)</option>
                  <option>Aeries</option>
                  <option>Alma</option>
                  <option>Genesis</option>
                  <option>Gradelink</option>
                  <option>Other</option>
                  <option>Unknown</option>
                </select>
              </div>
              <div class="demo-field">
                <label for="demo-availability">When do you generally have time for demos?</label>
                <select id="demo-availability" name="availability">
                  <option value="" disabled selected>Select a time…</option>
                  <option>Monday morning</option>
                  <option>Monday afternoon</option>
                  <option>Tuesday morning</option>
                  <option>Tuesday afternoon</option>
                  <option>Wednesday morning</option>
                  <option>Wednesday afternoon</option>
                  <option>Thursday morning</option>
                  <option>Thursday afternoon</option>
                  <option>Friday morning</option>
                  <option>Friday afternoon</option>
                  <option>Evenings</option>
                  <option>Weekends</option>
                </select>
              </div>
              <button type="submit" class="demo-submit" id="demo-submit-btn">
                Sign Me Up →
              </button>
              <div class="demo-privacy">By entering, you agree to be contacted by <strong>Nifty Ed Tools</strong> about the raffle and our attendance product. View our <a href="/privacy" style="color:inherit;text-decoration:underline;">Privacy Policy</a> and <a href="/terms" style="color:inherit;text-decoration:underline;">Terms and Conditions</a>.</div>
            </div>
          </form>
        </div>
        <div class="demo-success" id="demo-success">
          <div class="demo-success-icon">✓</div>
          <div class="demo-success-title">Thanks for entering the Nifty Attendance&#8482; Raffle!</div>
          <div class="demo-success-sub">Good luck!</div>
        </div>
      </div>
      </product>

      <SmsCarousel id="f4a71c93-2e85-4d57-b8e1-6c9d0a3f7e24" />

    </div>
  </div>

  <Footer tagline="Ed tech built by educators, for educators. Never a replacement — always an amplifier." />

</product>
</Layout>

<script is:inline>
  function formatPhone(e) {
    const input = e.target;
    const digits = input.value.replace(/\D/g, '').slice(0, 10);
    let formatted = digits;
    if (digits.length > 6)      formatted = '(' + digits.slice(0,3) + ') ' + digits.slice(3,6) + '-' + digits.slice(6);
    else if (digits.length > 3) formatted = '(' + digits.slice(0,3) + ') ' + digits.slice(3);
    else if (digits.length > 0) formatted = '(' + digits;
    input.value = formatted;
  }

  document.getElementById('demo-phone').addEventListener('input', formatPhone);

  async function handleSubmit(e) {
    e.preventDefault();
    const btn  = document.getElementById('demo-submit-btn');
    const form = document.getElementById('demo-form');

    if (document.getElementById('demo-honeypot').value) return;

    btn.disabled = true;
    btn.textContent = 'Sending…';

    const data = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch('/api/marketing/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name:              data.name,
          phone_number:      data.phone.replace(/\D/g, ''),
          district_name:     data.district,
          email:             data.email || null,
          source:            'raffle',
          sis_name:          data.sis || null,
          demo_availability: data.availability || null,
        }),
      });
      if (!res.ok) throw new Error(await res.text());
      document.getElementById('demo-form-body').style.display = 'none';
      document.getElementById('demo-success').style.display = 'flex';
    } catch {
      btn.disabled = false;
      btn.textContent = 'Sign Me Up →';
      alert('Something went wrong. Please try again or email us directly.');
    }
  }
</script>
