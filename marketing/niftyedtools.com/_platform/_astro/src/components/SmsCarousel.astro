---
import { smsMessages } from '../data/smsMessages';

interface Props {
  id?: string;
  title?: string;
}

const { id = '', title = 'See Nifty Attendance™ <span>in action</span>' } = Astro.props;

const slides = smsMessages;
---
<product id={id}>
<style is:global>
  .demo-receive {
    display: flex; flex-direction: column; gap: 1.5rem; min-width: 0;
  }
  .demo-receive-title {
    font-size: 1.35rem; font-weight: 800; color: var(--slate-900); line-height: 1.3;
  }
  .demo-receive-title span { color: var(--accent); }

  .carousel { display: flex; flex-direction: column; gap: 1rem; width: 100%; min-width: 0; }
  .carousel-description {
    display: flex; gap: 0.85rem; align-items: flex-start; min-height: 3.5rem;
    transition: opacity 0.25s;
  }
  .carousel-desc-icon {
    width: 2.25rem; height: 2.25rem; border-radius: 10px;
    background: rgba(249,115,22,0.1); color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem; flex-shrink: 0; margin-top: 0.1rem;
  }
  .carousel-desc-body {
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .carousel-desc-title {
    font-size: 0.72rem; font-weight: 800; color: var(--accent);
    letter-spacing: 0.07em; text-transform: uppercase; line-height: 1;
  }
  .carousel-desc-text {
    font-size: 0.88rem; color: var(--slate-500); line-height: 1.6;
  }
  .carousel-viewport {
    overflow: hidden; border-radius: 12px; width: 100%;
  }
  .carousel-track {
    display: flex; transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); width: 100%;
  }
  .carousel-slide {
    min-width: 100%; width: 100%; flex-shrink: 0; box-sizing: border-box;
  }

  /* iPhone Messages UI */
  .iphone-frame {
    border-radius: 15px; overflow: hidden;
    border: 1px solid #d1d5db;
    box-shadow: 0 6px 24px rgba(0,0,0,0.10);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    width: 100%;
  }
  .iphone-header {
    background: #f9f9f9; border-bottom: 1px solid #e5e7eb;
    padding: 0.5rem 0.75rem;
    display: flex; align-items: center; gap: 0.45rem;
  }
  .iphone-back { color: #007aff; font-size: 0.85rem; line-height: 1; }
  .iphone-avatar {
    width: 1.5rem; height: 1.5rem; border-radius: 50%;
    background: #6b7280; color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.56rem; font-weight: 700; flex-shrink: 0;
  }
  .iphone-contact { display: flex; flex-direction: column; flex: 1; }
  .iphone-contact-name { font-size: 0.6rem; font-weight: 600; color: #111827; }
  .iphone-contact-sub { font-size: 0.51rem; color: #6b7280; }
  .iphone-body {
    background: #ffffff; padding: 0.75rem 0.75rem 0.94rem;
    display: flex; flex-direction: column; gap: 0.3rem;
  }
  .iphone-timestamp {
    text-align: center; font-size: 0.51rem; color: #9ca3af; margin-bottom: 0.2rem;
  }
  .iphone-bubble-row { display: flex; align-items: flex-end; gap: 0.3rem; }
  .iphone-bubble {
    background: #e5e5ea; border-radius: 14px 14px 14px 3px;
    padding: 0.45rem 0.7rem;
    font-size: 0.64rem; color: #111827; line-height: 1.55;
    white-space: pre-wrap; max-width: 88%;
  }
  .iphone-bubble .sms-phone { color: #007aff; text-decoration: underline; }
  .iphone-bubble .sms-divider { color: #9ca3af; }
  .iphone-footer {
    background: #f9f9f9; border-top: 1px solid #e5e7eb;
    padding: 0.375rem 0.56rem;
    display: flex; align-items: center; gap: 0.375rem;
  }
  .iphone-input-bar {
    flex: 1; background: white; border: 1px solid #d1d5db;
    border-radius: 999px; padding: 0.25rem 0.65rem;
    font-size: 0.6rem; color: #9ca3af;
  }
  .iphone-send {
    width: 1.3rem; height: 1.3rem; border-radius: 50%;
    background: #007aff; color: white; border: none;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.6rem;
  }

  /* Document preview (coming soon) */
  .doc-frame {
    border-radius: 15px; overflow: hidden;
    border: 1px solid #d1d5db;
    box-shadow: 0 6px 24px rgba(0,0,0,0.10);
    width: 100%; position: relative;
  }
  .doc-frame img {
    width: 100%; display: block;
    object-fit: cover; object-position: top;
    height: 240px;
  }

  /* Option 1: gradient overlay from bottom */
  .doc-gradient-overlay {
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, transparent 100%);
    display: flex; align-items: flex-end; justify-content: center;
    padding-bottom: 1rem;
  }
  .doc-gradient-label {
    color: white; font-size: 0.7rem; font-weight: 800;
    letter-spacing: 0.1em; text-transform: uppercase;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* Option 5: frosted glass strip across center */
  .doc-frosted-strip {
    position: absolute; top: 50%; left: 0; right: 0;
    transform: translateY(-50%);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    background: rgba(255,255,255,0.22);
    border-top: 1px solid rgba(255,255,255,0.45);
    border-bottom: 1px solid rgba(255,255,255,0.45);
    padding: 0.7rem 1rem; text-align: center;
    color: white; font-size: 0.7rem; font-weight: 800;
    letter-spacing: 0.1em; text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0,0,0,0.45);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .carousel-nav {
    display: flex; align-items: center; justify-content: center; gap: 0.375rem;
  }
  .carousel-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--slate-200); border: none; cursor: pointer;
    padding: 0; transition: background 0.2s, transform 0.2s;
  }
  .carousel-dot.active { background: var(--accent); transform: scale(1.3); }
  .carousel-btn {
    background: none; border: 1.5px solid var(--slate-200); border-radius: 50%;
    width: 1.5rem; height: 1.5rem; cursor: pointer; display: flex;
    align-items: center; justify-content: center; color: var(--slate-500);
    font-size: 0.7rem; transition: border-color 0.15s, color 0.15s;
  }
  .carousel-btn:hover { border-color: var(--accent); color: var(--accent); }

  .carousel-explore-btn {
    display: inline-block;
    background: var(--accent); color: white;
    text-decoration: none; padding: 0.6rem 1.5rem;
    border-radius: 8px; font-size: 0.85rem; font-weight: 700;
    box-shadow: 0 3px 10px rgba(249,115,22,0.25);
    transition: background 0.15s, transform 0.1s;
  }
  .carousel-explore-btn:hover { background: var(--accent-hover); transform: translateY(-1px); }
</style>

<div class="demo-receive">
  <div class="demo-receive-title" set:html={title} />
  <div class="carousel">
    <div class="carousel-description" id="carousel-desc"></div>
    <div class="carousel-viewport">
      <div class="carousel-track" id="carousel-track">
        {slides.map((slide) => (
          <div class="carousel-slide">
            {slide.comingSoon ? (
              <div class="doc-frame">
                <img src={slide.image} alt={slide.title} />
                {slide.comingSoonStyle === 'gradient' && (
                  <div class="doc-gradient-overlay">
                    <span class="doc-gradient-label">Coming Soon</span>
                  </div>
                )}
                {slide.comingSoonStyle === 'frosted' && (
                  <div class="doc-frosted-strip">Coming Soon</div>
                )}
              </div>
            ) : (
              <div class="iphone-frame">
                <div class="iphone-header">
                  <span class="iphone-back">‹</span>
                  <div class="iphone-avatar">NA</div>
                  <div class="iphone-contact">
                    <div class="iphone-contact-name">Nifty Attendance</div>
                    <div class="iphone-contact-sub">Text Message</div>
                  </div>
                </div>
                <div class="iphone-body">
                  <div class="iphone-timestamp">{slide.timestamp}</div>
                  <div class="iphone-bubble-row">
                    <div class="iphone-bubble" set:html={slide.message} />
                  </div>
                </div>
                <div class="iphone-footer">
                  <div class="iphone-input-bar">Text Message</div>
                  <button class="iphone-send">↑</button>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
    <div class="carousel-nav">
      <button class="carousel-btn" id="carousel-prev">&#8592;</button>
      {slides.map((_, i) => (
        <button class={`carousel-dot${i === 0 ? ' active' : ''}`} data-index={i} />
      ))}
      <button class="carousel-btn" id="carousel-next">&#8594;</button>
    </div>
    <div style="text-align:center; padding-top:20px;">
      <a href="/attendance" class="carousel-explore-btn">Explore Attendance Features →</a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ slides }}>
  let current = 0;
  const track = document.getElementById('carousel-track');
  const desc  = document.getElementById('carousel-desc');
  const dots  = document.querySelectorAll('.carousel-dot');

  function goTo(index) {
    current = (index + slides.length) % slides.length;
    track.style.transform = `translateX(-${current * 100}%)`;
    desc.innerHTML = `
      <div class="carousel-desc-icon">${slides[current].icon}</div>
      <div class="carousel-desc-body">
        <div class="carousel-desc-title">${slides[current].title}</div>
        <div class="carousel-desc-text">${slides[current].description}</div>
      </div>
    `;
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }

  goTo(0);
  document.getElementById('carousel-prev').addEventListener('click', () => goTo(current - 1));
  document.getElementById('carousel-next').addEventListener('click', () => goTo(current + 1));
  dots.forEach(d => d.addEventListener('click', () => goTo(+d.dataset.index)));
</script>
</product>
