---
<product id="5835e805-9c0d-4fbc-a7e4-e3c7d47ddde5">
<style is:global>
  /* <product id="5835e805-9c0d-4fbc-a7e4-e3c7d47ddde5"> */
  /* ── PAGE HERO ───────────────────────────────────────────── */
  .page-hero {
    background: linear-gradient(150deg, var(--brand-950) 0%, var(--brand-900) 55%, var(--brand-700) 100%);
    padding: 4rem 2rem 3.5rem; text-align: center;
  }
  .page-hero h1 {
    font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 900;
    color: white; line-height: 1.1; margin-bottom: 1rem;
  }
  .page-hero h1 span { color: var(--accent); }
  .page-hero p {
    font-size: 1.05rem; color: rgba(255,255,255,0.75);
    max-width: 560px; margin: 0 auto; line-height: 1.7;
  }

  /* ── BUTTONS ─────────────────────────────────────────────── */
  .btn-primary {
    display: inline-block; background: var(--accent); color: white;
    text-decoration: none; padding: 0.8rem 1.75rem;
    border-radius: 8px; font-size: 0.95rem; font-weight: 700;
    transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
  }
  .btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.3); }
  .btn-ghost {
    display: inline-block; background: rgba(255,255,255,0.1);
    border: 1.5px solid rgba(255,255,255,0.3);
    color: white; text-decoration: none; padding: 0.8rem 1.75rem;
    border-radius: 8px; font-size: 0.95rem; font-weight: 600;
    transition: background 0.15s;
  }
  .btn-ghost:hover { background: rgba(255,255,255,0.18); }
  .btn-white {
    background: white; color: #c2410c;
    padding: 0.875rem 2rem; border-radius: 8px;
    font-size: 0.95rem; font-weight: 700; text-decoration: none;
    display: inline-block; transition: background 0.15s, transform 0.1s;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
  }
  .btn-white:hover { background: #fff7ed; transform: translateY(-2px); }

  /* ── SHARED ──────────────────────────────────────────────── */
  .section { padding: 5rem 1.5rem; }
  .section-alt { background: var(--slate-50); }
  .container { max-width: 1080px; margin: 0 auto; }
  .eyebrow {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 0.75rem;
  }
  .section-heading {
    font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800;
    color: var(--slate-800); line-height: 1.2; margin-bottom: 1rem;
  }
  .section-sub {
    font-size: 1.05rem; color: var(--slate-500); max-width: 560px; line-height: 1.65;
  }
  .section-header { margin-bottom: 3.5rem; }
  .section-header.center { text-align: center; }
  .section-header.center .section-sub { margin: 0 auto; }

  /* ── CTA BANNER ──────────────────────────────────────────── */
  .cta-banner {
    padding: 5rem 1.5rem; text-align: center;
  }
  .cta-banner h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem); font-weight: 900;
    color: white; margin-bottom: 1rem; line-height: 1.2;
  }
  .cta-banner p { font-size: 1.05rem; color: rgba(255,255,255,0.75); margin-bottom: 2.25rem; }
  .cta-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  /* </product> */
</style>
</product>
